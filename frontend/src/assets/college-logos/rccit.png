<script type="text/javascript">
$("#datepicker1").datetimepicker({
    useCurrent: false,
    format: "YYYY-MM-DD",
    showTodayButton: true,
    icons: {
        next: "fa fa-chevron-right",
        previous: "fa fa-chevron-left",
        today: 'todayText',
    }
});

$("#datepicker2").datetimepicker({
    useCurrent: false,
    format: "YYYY-MM-DD",
    showTodayButton: true,
    icons: {
        next: "fa fa-chevron-right",
        previous: "fa fa-chevron-left",
        today: 'todayText',
    }
});
    
$(document).ready(function() {
    $('#srh-btn').on("click",function (e) { 
        $("#start-date-err-msg").text("");
        $("#end-date-err-msg").text("");
        var start_date = $("#start-date").val();
        var end_date = $("#end-date").val();
        var start_date_format = new Date(start_date);
        var end_date_format = new Date(end_date);
        
        if (start_date == "") 
            $("#start-date-err-msg").text("Please choose start date!");
        else if (end_date == "") 
            $("#end-date-err-msg").text("Please choose end date!");
        else if (start_date_format > end_date_format) 
            $("#end-date-err-msg").text("End date must me grater than start date!");
        else 
            $("form#srh-frm").submit();
    });

    var currPage = 1;
    $("a#load-more").click(function() {
        loadMore(++currPage);
    });
});

function loadMore(page_no) {
    $("a#load-more").text('Loading...');
    var slug = $("#slug-input").val();
    var start_date = $("#start-date").val();
    var end_date = $("#end-date").val();
    var url = $("a#load-more").data("url");
    $.get(
        url, 
        {
            slug: slug,
            page_no: page_no,
            start_date: start_date,
            end_date: end_date,
        }, 
        function(response) {
            $("#list_cont").append(response);
            $("a#load-more").text('Load More');
            var next_page = $("#next-page").val();
            if (next_page == "no_next_page") {
                $("a#load-more").hide();
            }
        }
    );
}

$(window).on("scroll", function() {
    if ($(window).scrollTop() > 50) {
        $("#header").addClass("active");
    } else {
        //remove the background property so it comes transparent again (defined in your css)
        $("#header").removeClass("active");
    }
});

