<script>
    $(document).ready(function(){
  $(".fancybox").fancybox({
        openEffect: "none",
        closeEffect: "none"
    });
    
    $(".zoom").hover(function(){
        
        $(this).addClass('transition');
    }, function(){
        
        $(this).removeClass('transition');
    });
});
   

function search(ele) {
    if(event.key === 'Enter') {
        //alert(ele.value);
var val = ele.value;
window.location.href='https://rcciit.edu.in/search/'+val;        
    }
}
 
</script>

<script>
    $('.share').click(function(event) {
        $(this).parent().find('.shareCont').toggleClass('show');
    });

    $('.submissions_drawing').mouseleave(function(event) {
        $(this).find('.shareCont').removeClass('show');
    });
</script>
<script>
function getDirections() {
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(function(position) {
      let lat = position.coords.latitude;
      let lng = position.coords.longitude;

      // Your destination
      let destination = "Canal S Rd Beleghata Kolkata 700015, India";

      // Build Google Maps URL with real coordinates
      let mapsUrl = `https://www.google.com/maps/dir/?api=1&origin=${lat},${lng}&destination=${encodeURIComponent(destination)}&travelmode=driving`;

      window.open(mapsUrl, "_blank");
    }, function() {
      alert("Unable to fetch your location.");
    });
  } else {
    alert("Geolocation is not supported by your browser.");
  }
}
</script>
